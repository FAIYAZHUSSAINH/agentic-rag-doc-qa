# Copy this file to .env and fill in real values. .env itself is gitignored
# so secrets never get committed - this file documents what's needed without
# containing any actual secret.

# Shared-secret key required in the X-API-Key header for /populate/ and
# /query/. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=changeme

# Where the FastAPI app looks for Ollama's HTTP API. Defaults to localhost
# for bare-metal dev; override to the Docker Compose service name (e.g.
# http://ollama:11434) when running in containers (Phase 4).
OLLAMA_BASE_URL=http://localhost:11434
