# Copy this file to .env and fill in real values. .env itself is gitignored
# so secrets never get committed - this file documents what's needed without
# containing any actual secret.

# Shared-secret key required in the X-API-Key header for /populate/ and
# /query/. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=changeme

# Where the FastAPI app looks for Ollama's HTTP API. localhost is correct
# for bare-metal dev. docker-compose.yml overrides this automatically to
# http://host.docker.internal:11434 when running in Docker (Phase 4) -
# Ollama itself isn't containerized, it stays on the host - so you don't
# need to change this value here just to use Docker.
OLLAMA_BASE_URL=http://localhost:11434

# --- Phase 4: Docker / Chroma deployment mode ---
# "local" (default) = embedded Chroma, a directory on disk - what bare-metal
# dev uses. docker-compose.yml overrides these three to run against the
# standalone "chroma" service instead; you don't need to set them here
# unless you're deliberately running this app against a Chroma server
# outside of docker-compose too.
# CHROMA_MODE=local
# CHROMA_HTTP_HOST=chroma
# CHROMA_HTTP_PORT=8000

# --- Phase 3: Corrective RAG / web fallback ---

# Free key from https://tavily.com - used by /query/ to search the live web
# when local document retrieval looks weak (see SIMILARITY_THRESHOLD and
# the sufficiency check in rag_api.py). Web fallback fails gracefully
# (falls back to local-context-only) if this is missing or invalid.
TAVILY_API_KEY=changeme

# Minimum cosine similarity (0-1) a retrieved chunk must hit before we skip
# the web fallback. 0.5 was empirically measured on the sample PDF - see
# the SIMILARITY_THRESHOLD comment in rag_api.py for the actual numbers.
# Re-tune this if you swap in a very different corpus.
SIMILARITY_THRESHOLD=0.5

# Set to "false" to disable the web fallback entirely (e.g. fully offline
# dev, or a deployment that should never leave the local corpus).
WEB_FALLBACK_ENABLED=true

# How many web results to fetch and merge into context when falling back.
WEB_SEARCH_MAX_RESULTS=3
