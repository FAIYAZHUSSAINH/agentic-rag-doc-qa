# Virtual environment - never commit this, it's machine-specific and huge
venv/
__pycache__/
*.pyc

# ChromaDB's on-disk data. This is regenerated by POST /populate/, so
# committing it bloats the repo with binary diffs and can go stale
# relative to the docs/ PDFs it was built from - regenerate, don't version.
chroma/

# Secrets (API keys added in Phase 2) - never commit these
.env
